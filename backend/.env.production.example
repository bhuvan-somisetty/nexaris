# ---- Backend production environment (Railway / Render / Fly) ----

# Hosted Postgres (Neon / Supabase). Must allow CREATE EXTENSION pg_trgm + unaccent.
# Neon example: postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Upstash Redis (rediss:// with TLS). BullMQ workers + cache use this.
REDIS_URL="rediss://default:PASSWORD@HOST.upstash.io:6379"

# Auth secrets — generate strong random values, e.g. `openssl rand -hex 32`
JWT_SECRET="CHANGE_ME"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="CHANGE_ME_TOO"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=production

# CORS / frontend origin (set to your Vercel URL once known)
FRONTEND_URL="https://your-app.vercel.app"
