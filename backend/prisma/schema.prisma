datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum NotificationType {
  ORDER_CREATED
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  REFUND_CREATED
  REVIEW_RECEIVED
  REVIEW_REPORTED
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  SYSTEM_ALERT
  ORDER_UPDATE
  PROMOTION
  AUTH
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  passwordHash        String
  role                Role           @default(CUSTOMER)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  profile             Profile?
  sellerProfile       SellerProfile?
  refreshTokens       RefreshToken[]
  addresses           Address[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  products            Product[]
  cart                Cart?
  wishlist            Wishlist?
  orders              Order[]
  reviews             Review[]
  reviewVotes         ReviewVote[]
  reviewReports       ReviewReport[]
  sellerRatingsGiven  SellerRating[] @relation("SellerRatingsGiven")
  sellerRatingsRecv   SellerRating[] @relation("SellerRatingsReceived")
  notificationPrefs   NotificationPreference[]
  couponRedemptions   CouponRedemption[]
  couponsCreated      Coupon[]
  campaignsCreated    Campaign[]
  userSegments        UserSegment[]
  userActivities      UserActivity[]
  referralCode        ReferralCode?
  referralsGiven      Referral[]             @relation("Referrer")
  referralReceived    Referral?              @relation("Referee")
  loyaltyProfile      LoyaltyProfile?
  loyaltyHistory      LoyaltyHistory[]
  // Phase 11 back-relations
  preferenceProfile   UserPreferenceProfile?
  recEvents           RecommendationEvent[]
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SellerProfile {
  id               String       @id @default(uuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName        String       @unique
  storeDescription String?
  status           SellerStatus @default(PENDING)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Address {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       AddressType @default(SHIPPING)
  isDefault  Boolean     @default(false)
  firstName  String
  lastName   String
  street1    String
  street2    String?
  city       String
  state      String
  postalCode String
  country    String
  phone      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Notification {
  id           String                   @id @default(uuid())
  userId       String
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         NotificationType
  title        String
  message      String
  isRead       Boolean                  @default(false)
  archived     Boolean                  @default(false)
  metadata     Json?
  deliveryLogs NotificationDeliveryLog[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String   // e.g. "USER", "SELLER_PROFILE", "PRODUCT"
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  campaigns   Campaign[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id           String             @id @default(uuid())
  sellerId     String
  seller       User               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category           @relation(fields: [categoryId], references: [id])
  name         String
  slug         String             @unique
  description  String
  price        Decimal
  sku          String?            @unique
  status       ProductStatus      @default(DRAFT)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  images       ProductImage[]
  variants     ProductVariant[]
  attributes   ProductAttribute[]
  inventory    Inventory?
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  reviews       Review[]
  views         ProductView[]
  campaigns     CampaignProduct[]
  activities    UserActivity[]
  // Phase 11 back-relations
  similarTo    ProductSimilarity[] @relation("ProductASimilarity")
  similarFrom  ProductSimilarity[] @relation("ProductBSimilarity")
  recEvents    RecommendationEvent[]
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductVariant {
  id        String     @id @default(uuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String     @unique
  price     Decimal?   // Overrides main product price if provided
  name      String     // e.g. "Red / Medium"
  options   Json       // e.g. { "Color": "Red", "Size": "Medium" }
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  inventory Inventory?
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
}

model ProductAttribute {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String   // e.g. "Brand", "RAM", "Material"
  value     String   // e.g. "Apple", "16GB", "100% Cotton"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Inventory {
  id                String          @id @default(uuid())
  productId         String?         @unique
  product           Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?         @unique
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity          Int             @default(0)
  reserved          Int             @default(0)
  lowStockThreshold Int             @default(5)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  expiresAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([cartId, productId, variantId])
}

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model WishlistItem {
  id        String          @id @default(uuid())
  wishlistId String
  wishlist  Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([wishlistId, productId, variantId])
}

enum OrderStatus {
  PENDING
  PAYMENT_FAILED
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id                String          @id @default(uuid())
  customerId        String
  customer          User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status            OrderStatus     @default(PENDING)
  subtotal          Decimal
  tax               Decimal
  shipping          Decimal
  total             Decimal
  discount          Decimal         @default(0)
  couponCode        String?
  shippingAddress   OrderAddress?
  items             OrderItem[]
  timeline          OrderTimeline[]
  payment           Payment?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id                String            @id @default(uuid())
  orderId           String
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId         String?
  variant           ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity          Int
  price             Decimal
  
  // Snapshots for historical integrity
  productName       String
  productSlug       String
  productImage      String?
  variantName       String?
  variantSku        String?
  sellerId          String
  
  // Seller-level fulfillment tracking
  fulfillmentStatus FulfillmentStatus @default(PENDING)

  @@index([sellerId])
  @@index([sellerId, productId])
}

model OrderAddress {
  id         String   @id @default(uuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  street1    String
  street2    String?
  city       String
  state      String
  postalCode String
  country    String
  phone      String?
}

model OrderTimeline {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  notes     String?
  actorId   String?     // ID of user who modified status
  createdAt DateTime    @default(now())
}

// ─── Payment System ───────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  MOCK
  RAZORPAY
}

enum PaymentMethod {
  MOCK
  UPI
  CARD
  NETBANKING
  WALLET
}

model Payment {
  id                  String          @id @default(uuid())
  orderId             String          @unique
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider            PaymentProvider @default(MOCK)
  status              PaymentStatus   @default(PENDING)
  amount              Decimal
  currency            String          @default("INR")
  paymentMethod       PaymentMethod?  // Optional: populated after payment completion
  providerOrderId     String?         // Razorpay order_id (null for MOCK)
  providerPaymentId   String?         // Razorpay payment_id after capture
  providerSignature   String?         // Razorpay HMAC signature for verification
  idempotencyKey      String          @unique // UUID generated at checkout; prevents duplicate charges
  expiresAt           DateTime        // Payment window expiry (15 min from creation)
  attempts            PaymentAttempt[]
  refunds             Refund[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model PaymentAttempt {
  id            String        @id @default(uuid())
  paymentId     String
  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  attemptNumber Int           // 1-based retry counter (1 = first attempt, 2 = first retry, etc.)
  status        PaymentStatus
  providerRef   String?       // Provider transaction reference for this attempt
  failureReason String?       // Error message on failure
  metadata      Json?         // Raw provider response snapshot
  createdAt     DateTime      @default(now())
}

model Refund {
  id               String        @id @default(uuid())
  paymentId        String
  payment          Payment       @relation(fields: [paymentId], references: [id])
  amount           Decimal
  reason           String?
  status           PaymentStatus @default(PENDING) // PENDING → SUCCESS / FAILED
  providerRefundId String?       // Razorpay refund_id
  initiatedById    String        // Admin or system user ID who triggered refund
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

// ─── Reviews & Ratings System ────────────────────────────────────────────────

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model Review {
  id               String           @id @default(uuid())
  productId        String
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId       String
  customer         User             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating           Int
  title            String
  content          String
  images           String[]
  verified         Boolean          @default(false)
  status           ReviewStatus     @default(PUBLISHED)
  moderationStatus ModerationStatus @default(APPROVED)
  votes            ReviewVote[]
  reports          ReviewReport[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([productId, customerId])
}

model ReviewVote {
  id         String   @id @default(uuid())
  reviewId   String
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([reviewId, customerId])
}

model ReviewReport {
  id         String       @id @default(uuid())
  reviewId   String
  review     Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  customerId String
  customer   User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reason     String
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model SellerRating {
  id         String   @id @default(uuid())
  sellerId   String
  seller     User     @relation("SellerRatingsReceived", fields: [sellerId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation("SellerRatingsGiven", fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sellerId, customerId])
}

// ─── Notification Infrastructure ──────────────────────────────────────────────

model NotificationPreference {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([userId, type, channel])
}

model NotificationTemplate {
  id            String              @id @default(uuid())
  type          NotificationType
  channel       NotificationChannel
  titleTemplate String
  bodyTemplate  String
  enabled       Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([type, channel])
}

model NotificationDeliveryLog {
  id             String              @id @default(uuid())
  notificationId String
  notification   Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)
  providerRef    String?
  error          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model ProductView {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

// ─── Marketing & Promotions System (Phase 10) ─────────────────────────────────

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum CampaignType {
  FLASH_SALE
  FESTIVAL_SALE
  SEASONAL
  BUY_X_GET_Y
  BUNDLE
  CATEGORY_DISCOUNT
}

enum SegmentType {
  NEW
  RETURNING
  HIGH_VALUE
  INACTIVE
  VIP
}

enum UserActivityType {
  CLICK
  ADD_TO_CART
  SEARCH
  VIEW
  PURCHASE
  WISHLIST
  REVIEW
  SESSION_START
  SESSION_END
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model Coupon {
  id                String             @id @default(uuid())
  code              String             @unique
  discountType      DiscountType
  value             Decimal
  minOrderValue     Decimal            @default(0)
  maxDiscountAmount Decimal?
  startDate         DateTime
  endDate           DateTime
  usageLimit        Int?
  usedCount         Int                @default(0)
  perUserLimit      Int                @default(1)
  sellerId          String?            // Nullable for Platform-wide coupons
  seller            User?              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  isActive          Boolean            @default(true)
  stackable         Boolean            @default(false)
  redemptions       CouponRedemption[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([code, isActive])
  @@index([sellerId])
}

model CouponRedemption {
  id               String   @id @default(uuid())
  couponId         String
  coupon           Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId       String
  customer         User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId          String
  discountApplied  Decimal
  createdAt        DateTime @default(now())

  @@unique([couponId, customerId, orderId])
  @@index([customerId])
}

model Campaign {
  id               String            @id @default(uuid())
  name             String
  description      String
  type             CampaignType
  discountType     DiscountType
  value            Decimal
  startDate        DateTime
  endDate          DateTime
  sellerId         String?           // Nullable for Platform-wide campaigns
  seller           User?             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isActive         Boolean           @default(true)
  isApproved       Boolean           @default(true)
  abTest           Boolean           @default(false)
  variant          String?           // e.g. "A" or "B"
  clicks           Int               @default(0)
  conversions      Int               @default(0)
  revenue          Decimal           @default(0)
  parentCampaignId String?
  parentCampaign   Campaign?         @relation("ABTestCampaign", fields: [parentCampaignId], references: [id], onDelete: Cascade)
  childCampaigns   Campaign[]        @relation("ABTestCampaign")
  products         CampaignProduct[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([sellerId])
  @@index([isActive, startDate, endDate])
}

model CampaignProduct {
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([campaignId, productId])
}

model UserSegment {
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment   SegmentType
  createdAt DateTime    @default(now())

  @@id([userId, segment])
}

model UserActivity {
  id           String           @id @default(uuid())
  userId       String?          // Nullable for guests
  user         User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityType UserActivityType
  productId    String?
  product      Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  metadata     Json?            // For search terms or page route details
  createdAt    DateTime         @default(now())

  @@index([userId, activityType])
  @@index([productId])
}

model ReferralCode {
  id        String   @id @default(uuid())
  code      String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Referral {
  id            String   @id @default(uuid())
  referrerId    String
  referrer      User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId     String   @unique
  referee       User     @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)
  rewardClaimed Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([referrerId])
}

model LoyaltyProfile {
  id        String      @id @default(uuid())
  userId    String      @unique
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    Int         @default(0)
  tier      LoyaltyTier @default(BRONZE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model LoyaltyHistory {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointsChange Int
  reason       String
  createdAt    DateTime @default(now())

  @@index([userId])
}

// ─── AI Recommendation Engine (Phase 11) ─────────────────────────────────────

model ProductSimilarity {
  id         String   @id @default(uuid())
  productIdA String
  productA   Product  @relation("ProductASimilarity", fields: [productIdA], references: [id], onDelete: Cascade)
  productIdB String
  productB   Product  @relation("ProductBSimilarity", fields: [productIdB], references: [id], onDelete: Cascade)
  score      Decimal
  updatedAt  DateTime @updatedAt

  @@unique([productIdA, productIdB])
  @@index([productIdA, score])
}

model UserPreferenceProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredCategories Json     // Map of categoryId -> weight
  preferredBrands     Json     // Map of brandName -> weight
  priceRangeLow       Decimal  @default(0)
  priceRangeHigh      Decimal  @default(100000)
  updatedAt           DateTime @updatedAt
}

model RecommendationCache {
  id        String   @id @default(uuid())
  cacheKey  String   @unique
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([cacheKey, expiresAt])
}

model RecommendationEvent {
  id                 String   @id @default(uuid())
  userId             String?
  user               User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendationType String   // SIMILAR | PERSONALIZED | TRENDING | FREQUENTLY_BOUGHT | ALSO_VIEWED | CATEGORY
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  interaction        String   // IMPRESSION | CLICK | PURCHASE
  createdAt          DateTime @default(now())

  @@index([userId, recommendationType])
  @@index([productId])
  @@index([createdAt])
}
