datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum NotificationType {
  ORDER_UPDATE
  PROMOTION
  AUTH
  SYSTEM
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  passwordHash        String
  role                Role           @default(CUSTOMER)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  profile             Profile?
  sellerProfile       SellerProfile?
  refreshTokens       RefreshToken[]
  addresses           Address[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  products            Product[]
  cart                Cart?
  wishlist            Wishlist?
  orders              Order[]
  reviews             Review[]
  reviewVotes         ReviewVote[]
  reviewReports       ReviewReport[]
  sellerRatingsGiven  SellerRating[] @relation("SellerRatingsGiven")
  sellerRatingsRecv   SellerRating[] @relation("SellerRatingsReceived")
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SellerProfile {
  id               String       @id @default(uuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName        String       @unique
  storeDescription String?
  status           SellerStatus @default(PENDING)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Address {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       AddressType @default(SHIPPING)
  isDefault  Boolean     @default(false)
  firstName  String
  lastName   String
  street1    String
  street2    String?
  city       String
  state      String
  postalCode String
  country    String
  phone      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  metadata  Json?            // For custom fields like orderId or productId
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String   // e.g. "USER", "SELLER_PROFILE", "PRODUCT"
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id           String             @id @default(uuid())
  sellerId     String
  seller       User               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category           @relation(fields: [categoryId], references: [id])
  name         String
  slug         String             @unique
  description  String
  price        Decimal
  sku          String?            @unique
  status       ProductStatus      @default(DRAFT)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  images       ProductImage[]
  variants     ProductVariant[]
  attributes   ProductAttribute[]
  inventory    Inventory?
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  reviews       Review[]
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductVariant {
  id        String     @id @default(uuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String     @unique
  price     Decimal?   // Overrides main product price if provided
  name      String     // e.g. "Red / Medium"
  options   Json       // e.g. { "Color": "Red", "Size": "Medium" }
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  inventory Inventory?
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
}

model ProductAttribute {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String   // e.g. "Brand", "RAM", "Material"
  value     String   // e.g. "Apple", "16GB", "100% Cotton"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Inventory {
  id                String          @id @default(uuid())
  productId         String?         @unique
  product           Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId         String?         @unique
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity          Int             @default(0)
  reserved          Int             @default(0)
  lowStockThreshold Int             @default(5)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  expiresAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([cartId, productId, variantId])
}

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model WishlistItem {
  id        String          @id @default(uuid())
  wishlistId String
  wishlist  Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([wishlistId, productId, variantId])
}

enum OrderStatus {
  PENDING
  PAYMENT_FAILED
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id                String          @id @default(uuid())
  customerId        String
  customer          User            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status            OrderStatus     @default(PENDING)
  subtotal          Decimal
  tax               Decimal
  shipping          Decimal
  total             Decimal
  shippingAddress   OrderAddress?
  items             OrderItem[]
  timeline          OrderTimeline[]
  payment           Payment?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model OrderItem {
  id                String            @id @default(uuid())
  orderId           String
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId         String?
  variant           ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity          Int
  price             Decimal
  
  // Snapshots for historical integrity
  productName       String
  productSlug       String
  productImage      String?
  variantName       String?
  variantSku        String?
  sellerId          String
  
  // Seller-level fulfillment tracking
  fulfillmentStatus FulfillmentStatus @default(PENDING)
}

model OrderAddress {
  id         String   @id @default(uuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  street1    String
  street2    String?
  city       String
  state      String
  postalCode String
  country    String
  phone      String?
}

model OrderTimeline {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  notes     String?
  actorId   String?     // ID of user who modified status
  createdAt DateTime    @default(now())
}

// ─── Payment System ───────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  MOCK
  RAZORPAY
}

enum PaymentMethod {
  MOCK
  UPI
  CARD
  NETBANKING
  WALLET
}

model Payment {
  id                  String          @id @default(uuid())
  orderId             String          @unique
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider            PaymentProvider @default(MOCK)
  status              PaymentStatus   @default(PENDING)
  amount              Decimal
  currency            String          @default("INR")
  paymentMethod       PaymentMethod?  // Optional: populated after payment completion
  providerOrderId     String?         // Razorpay order_id (null for MOCK)
  providerPaymentId   String?         // Razorpay payment_id after capture
  providerSignature   String?         // Razorpay HMAC signature for verification
  idempotencyKey      String          @unique // UUID generated at checkout; prevents duplicate charges
  expiresAt           DateTime        // Payment window expiry (15 min from creation)
  attempts            PaymentAttempt[]
  refunds             Refund[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model PaymentAttempt {
  id            String        @id @default(uuid())
  paymentId     String
  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  attemptNumber Int           // 1-based retry counter (1 = first attempt, 2 = first retry, etc.)
  status        PaymentStatus
  providerRef   String?       // Provider transaction reference for this attempt
  failureReason String?       // Error message on failure
  metadata      Json?         // Raw provider response snapshot
  createdAt     DateTime      @default(now())
}

model Refund {
  id               String        @id @default(uuid())
  paymentId        String
  payment          Payment       @relation(fields: [paymentId], references: [id])
  amount           Decimal
  reason           String?
  status           PaymentStatus @default(PENDING) // PENDING → SUCCESS / FAILED
  providerRefundId String?       // Razorpay refund_id
  initiatedById    String        // Admin or system user ID who triggered refund
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

// ─── Reviews & Ratings System ────────────────────────────────────────────────

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model Review {
  id               String           @id @default(uuid())
  productId        String
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId       String
  customer         User             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating           Int
  title            String
  content          String
  images           String[]
  verified         Boolean          @default(false)
  status           ReviewStatus     @default(PUBLISHED)
  moderationStatus ModerationStatus @default(APPROVED)
  votes            ReviewVote[]
  reports          ReviewReport[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([productId, customerId])
}

model ReviewVote {
  id         String   @id @default(uuid())
  reviewId   String
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([reviewId, customerId])
}

model ReviewReport {
  id         String       @id @default(uuid())
  reviewId   String
  review     Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  customerId String
  customer   User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reason     String
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model SellerRating {
  id         String   @id @default(uuid())
  sellerId   String
  seller     User     @relation("SellerRatingsReceived", fields: [sellerId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation("SellerRatingsGiven", fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sellerId, customerId])
}
